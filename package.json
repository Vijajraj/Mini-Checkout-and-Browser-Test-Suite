{
  "name": "mini-checkout",
  "version": "1.0.0",
  "description": "Mini Checkout and Browser Test Suite – FyndHacks SDET Intern assessment",
  "private": true,
  "scripts": {
    "start": "http-server . -p 4173 -c-1",
    "test": "playwright test",
    "test:repeat": "playwright test --repeat-each=5",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "lint": "eslint .",
    "verify": "npm run lint && npm test",
    "ci": "npm run lint && playwright test --repeat-each=5"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "eslint": "^9.20.1",
    "http-server": "^14.1.1"
  }
}
